{
  "name": "skvallerbyttan",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm test && npm run typecheck && npm run validate:worker",
    "deploy": "wrangler deploy",
    "verify:production": "node scripts/verify-production.mjs",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:worker": "wrangler deploy --dry-run",
    "deploy:workers-builds": "node scripts/workers-build-production.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "4.137.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
