{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skvallerbyttan",
  "main": "src/entry.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "*/15 * * * *"
    ]
  },
  "secrets": {
    "required": [
      "GAMNACKEN_GITHUB_APP_CLIENT_ID",
      "GAMNACKEN_GITHUB_APP_PRIVATE_KEY",
      "SKVALLERBYTTAN_SESSION_SECRET",
      "SKVALLERBYTTAN_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "b74f8c0c6a92f3006483840cf27372fd",
    "SKVALLERBYTTAN_ALLOWED_GITHUB_IDS": "36226327",
    "SKVALLERBYTTAN_GITHUB_OWNER": "blixten85",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23li4Zt1X87R3Sqc7T"
  },
  "secrets_store_secrets": [
    {
      "binding": "CLOUDFLARE_API_TOKEN_R1",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "CLOUDFLARE_API_TOKEN_R1"
    },
    {
      "binding": "CLOUDFLARE_API_TOKEN_R2",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "CLOUDFLARE_API_TOKEN_R2"
    },
    {
      "binding": "CLOUDFLARE_API_TOKEN_R3",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "CLOUDFLARE_API_TOKEN_R3"
    },
    {
      "binding": "GITHUB_OAUTH_CLIENT_SECRET",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "GITHUB_OAUTH_CLIENT_SECRET"
    }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "skvallerbyttan-stats-eu",
      "database_id": "5e30b2a0-e47f-43f9-95cd-fc59fb542073"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "OBSERVABILITY",
      "dataset": "skvallerbyttan_observability"
    }
  ],
  "services": [
    {
      "binding": "AVKROKEN_PORTAL_DOCS",
      "service": "avkroken",
      "entrypoint": "DocsInvalidationService"
    },
    {
      "binding": "AVKROKEN_OPERATIONS",
      "service": "avkroken",
      "entrypoint": "OperationalHeartbeatService"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SecurityAlertIssueLock"
      ]
    },
    {
      "tag": "v2",
      "renamed_classes": [
        {
          "from": "SecurityAlertIssueLock",
          "to": "SkvallerbyttanIssueLock"
        }
      ]
    },
    {
      "tag": "v3-dashboard",
      "deleted_classes": [
        "SkvallerbyttanIssueLock"
      ]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "skvallerbyttan.denied.se",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  },
  "account_id": "b74f8c0c6a92f3006483840cf27372fd",
  "previews": {
    "vars": {
      "SKVALLERBYTTAN_GITHUB_OWNER": "blixten85"
    },
    "analytics_engine_datasets": [
      {
        "binding": "OBSERVABILITY",
        "dataset": "skvallerbyttan_preview"
      }
    ]
  }
}
