# Copy to .dev.vars for local development. Never commit .dev.vars.

# GitHub OAuth is the only dashboard authentication path.
# Reuse the configured OAuth client; never commit its real secret.
# The production redirect URI is https://jobb.denied.se/auth/callback.
# GITHUB_OAUTH_CLIENT_ID="replace-with-client-id"
# GITHUB_OAUTH_CLIENT_SECRET="replace-with-client-secret"
# JOBB_ALLOWED_GITHUB_IDS="123456"

PUBLIC_BASE_URL="https://jobb.example.com"

# Turnstile protects user-triggered dashboard actions.
# In production TURNSTILE_SECRET must be stored as a Worker secret, not in Git.
TURNSTILE_SECRET="replace-with-turnstile-secret"
TURNSTILE_HOSTNAMES="localhost,127.0.0.1"

# StudentConsulting runtime credentials
STUDENTCONSULTING_EMAIL="user@example.com"
STUDENTCONSULTING_PASSWORD="replace-me"
STUDENTCONSULTING_AUTOSUBMIT="false"

# Suitability policy. Autonomous applications fail closed until include terms exist.
JOB_INCLUDE_TERMS="supporttekniker,it-support,helpdesk"
JOB_EXCLUDE_TERMS="chef,senior"
JOB_ALLOWED_LOCATIONS="Stockholm,Uppsala"
JOB_ALLOWED_COUNTRIES="SE"

# BankID notification. Cloudflare Email Service binding must be configured for email.
NOTIFY_EMAIL_TO="user@example.com"
NOTIFY_EMAIL_FROM="jobb@example.com"

# Optional generic HTTPS webhook for another notification channel.
# NOTIFY_WEBHOOK_URL="https://example.com/hooks/bankid"
