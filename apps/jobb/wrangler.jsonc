{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobb",
  "main": "apps/web/src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "vars": {
    "TURNSTILE_HOSTNAMES": "jobb.denied.se",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23li4Zt1X87R3Sqc7T",
    "JOBB_ALLOWED_GITHUB_IDS": "36226327"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  },
  "browser": {
    "binding": "BROWSER"
  },
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_OAUTH_CLIENT_SECRET",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "GITHUB_OAUTH_CLIENT_SECRET"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jobb-eu",
      "database_id": "58219fde-4782-4b28-acb3-186df203f2f7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "jobb-evidence"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "workflows": [
    {
      "name": "jobb-automation",
      "binding": "JOB_AUTOMATION",
      "class_name": "JobAutomationWorkflow"
    }
  ],
  "triggers": {
    "crons": [
      "0 9 10-13 * *"
    ]
  },
  "routes": [
    {
      "pattern": "jobb.denied.se",
      "custom_domain": true
    }
  ],
  "previews": {
    "browser": {
      "binding": "BROWSER"
    },
    "d1_databases": [
      {
        "binding": "DB"
      }
    ],
    "r2_buckets": [
      {
        "binding": "EVIDENCE"
      }
    ]
  }
}
