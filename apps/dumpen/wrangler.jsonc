{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dumpen",
  "main": "src/access.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-26",
  "account_id": "b74f8c0c6a92f3006483840cf27372fd",
  "vars": {
    "GITHUB_OAUTH_CLIENT_ID": "Ov23li4Zt1X87R3Sqc7T",
    "DUMPEN_ALLOWED_GITHUB_IDS": "36226327"
  },
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_OAUTH_CLIENT_SECRET",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "KROSA_MAJA_CLIENT_SECRET"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true
    }
  },
  "r2_buckets": [
    { "binding": "DUMPEN", "bucket_name": "dumpen" },
    { "binding": "ASSETS", "bucket_name": "avkroken-assets" }
  ],
  "previews": {},
  "routes": [
    { "pattern": "dumpen.denied.se", "custom_domain": true }
  ]
}
